{
  "name": "@dumpscan/match",
  "version": "1.0.0",
  "description": "The dumpscan matching engine. Pure functions only.",
  "keywords": [
    "vulnerability-matching",
    "osv",
    "version-ranges",
    "openvex",
    "vex"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moonrunnerkc/dumpscan.git",
    "directory": "packages/match"
  },
  "homepage": "https://github.com/moonrunnerkc/dumpscan#readme",
  "bugs": "https://github.com/moonrunnerkc/dumpscan/issues",
  "type": "module",
  "engines": {
    "node": ">=22.22.2"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@dumpscan/canon": "workspace:*",
    "@dumpscan/lockfiles": "workspace:*",
    "@dumpscan/merkle": "workspace:*",
    "@dumpscan/osv": "workspace:*",
    "@dumpscan/versions": "workspace:*"
  }
}
