{
  "name": "dumpscan",
  "version": "1.0.0",
  "description": "The dumpscan command line interface.",
  "keywords": [
    "vulnerability-scanner",
    "supply-chain-security",
    "sigstore",
    "in-toto",
    "attestation",
    "provenance",
    "osv",
    "reproducible",
    "sbom-alternative",
    "sarif",
    "dependency-scanning",
    "devsecops",
    "slsa",
    "openvex"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moonrunnerkc/dumpscan.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/moonrunnerkc/dumpscan#readme",
  "bugs": "https://github.com/moonrunnerkc/dumpscan/issues",
  "type": "module",
  "engines": {
    "node": ">=22.22.2"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "bin": {
    "dumpscan": "./dist/bin.js"
  },
  "dependencies": {
    "@dumpscan/canon": "workspace:*",
    "@dumpscan/diff": "workspace:*",
    "@dumpscan/explain": "workspace:*",
    "@dumpscan/lockfiles": "workspace:*",
    "@dumpscan/match": "workspace:*",
    "@dumpscan/merkle": "workspace:*",
    "@dumpscan/osv": "workspace:*",
    "@dumpscan/predicate": "workspace:*",
    "@dumpscan/sign": "workspace:*",
    "@dumpscan/versions": "workspace:*",
    "fflate": "0.8.3"
  }
}
