    "comparable-version",
    "go-modules",
    "version-comparison"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moonrunnerkc/dumpscan.git",
    "directory": "packages/versions"
  },
  "homepage": "https://github.com/moonrunnerkc/dumpscan#readme",
  "bugs": "https://github.com/moonrunnerkc/dumpscan/issues",
  "type": "module",
  "engines": {
    "node": ">=22.22.2"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@dumpscan/canon": "workspace:*",
